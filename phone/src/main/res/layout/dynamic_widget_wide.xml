<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
 android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_backdrop" android:layout_width="match_parent" android:layout_height="match_parent"
 android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone"/>
 <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
<TextClock android:id="@+id/widget_clock" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:maxLines="1"
 android:layout_width="match_parent" android:layout_toStartOf="@+id/widget_event" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_height="match_parent" android:gravity="center"
 android:textSize="58sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-light"
 android:shadowColor="#B3000000" android:shadowRadius="2" android:shadowDy="1"
 android:autoSizeTextType="uniform" android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="58sp" android:autoSizeStepGranularity="1sp"/>
  <FrameLayout android:id="@id/widget_event" android:layout_width="144dp" android:layout_height="match_parent"
   android:layout_alignParentEnd="true" android:visibility="invisible">
   <RelativeLayout android:layout_width="match_parent" android:layout_height="112dp" android:layout_gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp">
    <ImageView android:id="@+id/widget_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="8dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentEnd="true"
     android:gravity="center" android:textSize="12sp" android:textColor="#FFFFFFFF"/>
    <TextView android:id="@+id/widget_title" android:layout_below="@id/widget_toggle" android:layout_width="match_parent" android:layout_height="18dp"
     android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-medium" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"
     android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"/>
    <TextView android:id="@+id/widget_event_time" android:layout_below="@id/widget_title" android:layout_width="match_parent" android:layout_height="20dp"
     android:textColor="#FFFFFFFF" android:textSize="16sp" android:maxLines="1"
     android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp"/>
    <Chronometer android:id="@+id/widget_countdown" android:layout_below="@id/widget_event_time" android:layout_width="match_parent" android:layout_height="26dp"
     android:textColor="#FFFFFFFF" android:textSize="21sp" android:maxLines="1" android:fontFamily="sans-serif-medium"
     android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="21sp" android:autoSizeStepGranularity="1sp"/>
   </RelativeLayout>
  </FrameLayout>
 </RelativeLayout>
</FrameLayout>
