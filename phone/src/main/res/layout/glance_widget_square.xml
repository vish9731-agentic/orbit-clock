<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
 android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_backdrop" android:layout_width="match_parent" android:layout_height="match_parent"
 android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone"/><TextClock android:id="@+id/widget_clock" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:maxLines="1"
 android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
 android:textSize="58sp" android:textColor="#FFFFFFFF" android:fontFamily="sans-serif-light"
 android:shadowColor="#66000000" android:shadowRadius="2" android:shadowDy="1"
 android:autoSizeTextType="uniform" android:autoSizeMinTextSize="24sp" android:autoSizeMaxTextSize="58sp" android:autoSizeStepGranularity="1sp"/>
 <FrameLayout android:id="@+id/widget_event" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
  <LinearLayout android:layout_width="match_parent" android:layout_height="104dp" android:layout_gravity="center_vertical"
   android:paddingStart="14dp" android:paddingEnd="14dp" android:orientation="vertical">
   <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp">
    <ImageView android:id="@+id/widget_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="10dp" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentEnd="true"
     android:gravity="center" android:padding="8dp" android:textColor="#FFFFFFFF" android:textSize="12sp"/>
   </RelativeLayout>
   <TextView android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center"
    android:textColor="#FFFFFFFF" android:textSize="30sp" android:maxLines="2" android:fontFamily="sans-serif-medium"
    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"/>
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center"
    android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp"/>
   <TextView android:id="@+id/widget_event_time" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone"/>
  </LinearLayout>
 </FrameLayout>
</FrameLayout>
