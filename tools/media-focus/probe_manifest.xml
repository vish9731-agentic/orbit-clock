<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.orbit.focusprobe">
 <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <application android:label="Media focus probe" android:debuggable="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
  <activity android:name=".ProbeActivity" android:exported="true"/>
  <service android:name=".MusicService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
 </application>
</manifest>
