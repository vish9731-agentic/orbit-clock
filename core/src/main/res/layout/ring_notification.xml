<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/ring_notification_root" android:layout_width="match_parent" android:layout_height="88dp"
 android:orientation="vertical" android:paddingHorizontal="8dp" android:background="@drawable/ring_notification_surface">
 <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
  <TextView android:id="@+id/ring_notification_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="8dp" android:textColor="#dce6e0" android:textSize="14sp" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/ring_notification_less" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="−" android:textSize="22sp" android:textColor="#b9c9c1" android:contentDescription="Decrease snooze by 5 minutes"/>
  <TextView android:id="@+id/ring_notification_minutes" android:layout_width="50dp" android:layout_height="match_parent" android:gravity="center" android:textSize="13sp" android:textColor="#dce6e0" android:fontFamily="sans-serif-medium"/>
  <TextView android:id="@+id/ring_notification_more" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textSize="22sp" android:textColor="#b9c9c1" android:contentDescription="Increase snooze by 5 minutes"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/ring_notification_rail">
  <TextView android:id="@+id/ring_notification_snooze" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Snooze" android:textColor="#d3e3df" android:textSize="18sp" android:fontFamily="sans-serif"/>
  <ImageView android:layout_width="40dp" android:layout_height="24dp" android:src="@drawable/ic_alarm" android:tint="#74e8d7" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/ring_notification_stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Stop" android:textColor="#d3e3df" android:textSize="18sp" android:fontFamily="sans-serif"/>
 </LinearLayout>
</LinearLayout>
